# Copie este arquivo para .env e preencha. NUNCA envie o .env para o GitHub.

# Token da Duffel (painel da Duffel > Developers > Access tokens)
DUFFEL_ACCESS_TOKEN=duffel_test_coloque_seu_token_aqui

# Quem recebe os alertas
ALERTA_EMAIL=destinatario@exemplo.com

# Envio pela Brevo (recomendado): brevo.com > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-coloque_sua_chave_aqui
REMETENTE_EMAIL=seu_email_confirmado_na_brevo@exemplo.com

# OU envio por Gmail (senha de app) — deixe vazio se usar a Brevo
SMTP_USUARIO=
SMTP_SENHA=
